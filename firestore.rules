rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Reports ────────────────────────────────────────────────
    // Anyone can read reports (transparency requirement).
    // Only authenticated users can create.
    // Only the original reporter can update (or any authenticated user for
    // corroboration increments), and only non-sensitive fields.
    match /reports/{reportId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasAll(['description', 'category', 'lat', 'lng', 'status', 'reporterId'])
        && request.resource.data.status == 'open';

      // Allow any signed-in user to update (for corroboration counter bumps
      // and status changes by civic workers).
      allow update: if request.auth != null;

      // Only the original reporter can delete their own report.
      allow delete: if request.auth != null
        && resource.data.reporterId == request.auth.uid;
    }

    // ── Dispatch Plans ─────────────────────────────────────────
    // Only readable by authenticated users (internal operational data).
    // Written only by the server-side agent (via Admin SDK, which bypasses rules).
    match /dispatch_plans/{planId} {
      allow read: if request.auth != null;
      allow write: if false; // Server only
    }

    // ── User Profiles (future use) ──────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Notifications ───────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false; // Server only
    }
  }
}
